# Local development defaults only. Copy to .env and replace every CHANGE_ME value.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
TRUSTED_PROXY_IPS=
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE_NAME=EmployeeManagement
JWT_SECRET=CHANGE_ME_generate_at_least_48_random_bytes
JWT_ISSUER=EmployeeManagement
JWT_AUDIENCE=EmployeeManagementClients
JWT_EXPIRY_MINUTES=60
ADMIN_PROVISIONING_EMAIL=
ADMIN_PROVISIONING_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173


